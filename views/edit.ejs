<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-900 min-h-screen flex items-center justify-center">
    <div class="bg-gray-800 p-8 rounded-lg shadow-md w-full max-w-md text-white">
        <h1 class="text-2xl font-bold text-center mb-6">Update User</h1>

        <form action="/edit/<%= user._id %>" method="POST" class="space-y-4">
            <input type="text" name="name" value="<%= user.name %>" placeholder="Enter Name" required
                class="w-full px-4 py-2 border border-gray-600 bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">

            <input type="email" name="email" value="<%= user.email %>" placeholder="Enter Email" required
                class="w-full px-4 py-2 border border-gray-600 bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">

            <input type="text" name="image" value="<%= user.image %>" placeholder="Enter Image URL" required
                class="w-full px-4 py-2 border border-gray-600 bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">

            <button type="submit"
                class="w-full bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600 transition duration-200">Update</button>

            <a href="/read" class="block text-center text-gray-300 hover:text-gray-100 mt-4 underline">Cancel</a>
        </form>
    </div>
</body>

</html>