<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a href="/" class="text-blue-500 hover:underline">back to home</a>
        <h1 class="text-3xl mt-10 tracking-tighter mb-3">All Users</h1>

        <div class="users flex gap-3 flex-wrap">
            <% users.forEach((user)=> { %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg shadow-md hover:bg-zinc-700 transition duration-200">
                    <img src="<%= user.image %>" alt="User Image" class="w-full h-32 object-cover rounded-md mb-2">
                    <h2 class="text-xl font-semibold mb-2">
                        <%= user.name %>
                    </h2>
                    <p class="text-zinc-400">
                        <%= user.email %>
                    </p>

                    <!-- Delete button -->
                    <a href="/delete/<%= user._id %>"
                        class="block text-center bg-red-600 hover:bg-red-700 text-white mt-4 py-2 rounded-md transition duration-200">
                        Delete
                    </a>

                    <a href="/edit/<%= user._id %>"
                        class="block text-center bg-yellow-500 hover:bg-yellow-600 text-white mt-2 py-2 rounded-md transition duration-200">
                        Edit
                    </a>
                </div>
                <% }) %>
        </div>
    </div>
</body>

</html>